{
  "name": "calcul-cost-trajecte",
  "version": "1.3.0",
  "private": true,
  "description": "Calculadora del cost d'un viatge en cotxe elèctric, amb historial sincronitzat.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "serve public -l 8080",
    "lint": "npm run lint:js && npm run lint:html",
    "lint:js": "eslint .",
    "lint:html": "html-validate public/*.html",
    "test": "npm run test:e2e",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cost-trajecte \"node --test tests/rules/firestore.rules.test.js\"",
    "test:e2e": "playwright test",
    "assets": "node scripts/render-assets.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.34.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.4",
    "serve": "^14.2.6"
  }
}
